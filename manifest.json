{
  "manifest_version": 3,
  "name": "Context Vocab",
  "version": "1.0.0",
  "description": "Select any word on any webpage; AI explains it using surrounding context and saves it to Eudic with full provenance.",
  "author": "Context Vocab",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://my.eudic.net/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Context Vocab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/log.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
